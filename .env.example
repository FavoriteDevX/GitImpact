# ==============================================================================
# GitImpact - Global Environment Configurations Blueprint
# Duplicate this file to '.env' and populate with authentic dev/prod secrets.
# ==============================================================================

# 🌐 DEPLOYMENT CONTEXT
NODE_ENV=development
API_PORT=8000
DEBUG_MODE=true

# 🤖 ARTIFICIAL INTELLIGENCE CORE ENGINE (OpenAI API Validation)
# Required for semantic code summary generations and intent vector processing.
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 🐙 GITHUB DECOUPLED API CREDENTIALS
# A fine-grained Personal Access Token (PAT) with read permissions for metadata and repositories.
GITHUB_ACCESS_TOKEN=github_pat_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 🗄️ PERSISTENT DATABASE ENGINE CONFIGURATIONS (PostgreSQL + pgvector)
# Internal compose routing standard format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://gitimpact_admin:secure_dev_password@localhost:5432/gitimpact_prod?schema=public

# ⚡ HIGH-SPEED MEMORY CACHING ENGINE (Redis Rate-Limiter)
# Essential for Leaky Bucket orchestration algorithms protecting the system against GitHub API bans.
REDIS_URL=redis://localhost:6379/0

# ⚙️ ENGINE OPERATIONS & TUNING PARAMETERS (Optional adjustments overrides)
MAX_COMMIT_FETCH_LIMIT=100
AI_CONFIDENCE_ACCEPTANCE_THRESHOLD=0.75
RATE_LIMIT_BUCKET_CAPACITY=5000
